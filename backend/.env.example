# LLM 配置(必填)
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# 数据库
DB_URL=sqlite+aiosqlite:///./data/app.db
DB_SQL_ECHO=false

# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_CORS_ORIGINS=["http://localhost:5173"]

# 应用
APP_NAME=swift-agent
APP_SUPERVISOR_SYSTEM_PROMPT=你是 Supervisor,把任务分派给最合适的子 Agent ...

# LangGraph 持久化后端(开发期 memory,生产可换 postgres)
# CHECKPOINTER_BACKEND=memory
# STORE_BACKEND=memory
