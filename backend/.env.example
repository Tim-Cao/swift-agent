# LLM 配置(必填)
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# 数据库
DB_URL=sqlite+aiosqlite:///./data/app.db
DB_SQL_ECHO=false

# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_CORS_ORIGINS=["http://localhost:5173"]

# 应用
APP_NAME=swift-agent
APP_SUPERVISOR_SYSTEM_PROMPT=你是 Supervisor,把任务分派给最合适的子 Agent ...
# create_deep_agent(debug=) 开关:true 时 LangGraph 打印每个 node / tool_call /
# state 转换的详细 trace;生产可设 false 减少日志噪音。默认 true。
APP_SUPERVISOR_DEBUG=true

# LangGraph 持久化后端(开发期 memory,生产可换 postgres)
PERSISTENCE_CHECKPOINTER_BACKEND=memory
PERSISTENCE_STORE_BACKEND=memory
# Postgres 接入示例(留作占位,当前实现为 NotImplementedError)
# PERSISTENCE_CHECKPOINTER_BACKEND=postgres
# PERSISTENCE_CHECKPOINT_DB_URL=postgresql://user:pass@host:5432/langgraph
# PERSISTENCE_STORE_BACKEND=postgres
# PERSISTENCE_STORE_DB_URL=postgresql://user:pass@host:5432/langgraph